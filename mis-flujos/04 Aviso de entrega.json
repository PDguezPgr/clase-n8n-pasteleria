    {
      "parameters": {
        "jsCode": "// Un solo correo para Marisa con todas las entregas de mañana.\nconst entregas = $input.all().map(i => i.json);\nconst fecha = $now.plus({ days: 1 }).toFormat('dd/MM/yyyy');\n\nconst lineas = entregas.map(e => {\n  const estado = e.estado === 'pagado'\n    ? 'pagada'\n    : `faltan ${Number(e.pendiente).toFixed(2).replace('.', ',')} €`;\n  const sinEmail = e.sin_email ? ' · SIN EMAIL' : '';\n  return `- #${e.encargo_id} ${e.cliente}${sinEmail}: ${e.tarta} (${estado})`;\n});\n\nconst sinEmail = entregas.filter(e => e.sin_email).length;\nconst avisoEmail = sinEmail\n  ? 'Ojo: hay clientes sin email; avísales por teléfono.'\n  : 'Todos los clientes con email ya tienen su aviso.';\n\nconst texto = `Hola Marisa:\\n\\nMañana, ${fecha}, hay ${entregas.length} entrega(s):\\n\\n${lineas.join('\\n')}\\n\\n${avisoEmail}`;\n\nreturn [{ json: { fecha, n: entregas.length, texto_marisa: texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
