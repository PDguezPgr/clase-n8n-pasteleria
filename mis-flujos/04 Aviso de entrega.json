    {
      "parameters": {
        "jsCode": "// Fecha de mañana en la zona horaria de n8n (Europe/Madrid)\nconst manana = $now.plus({ days: 1 });\nconst fecha = manana.toFormat('yyyy-MM-dd');\nconst fechaBonita = manana.toFormat('dd/MM/yyyy');\n\n// La API devuelve todos los encargos; aquí solo se filtra por fecha y estado.\nconst encargos = $input.all().map(i => i.json).filter(e => e && e.id);\nconst entregas = encargos.filter(e =>\n  e.fecha_entrega === fecha && (e.estado === 'pendiente' || e.estado === 'pagado')\n);\n\n// Un item por encargo: el nodo de correo manda un email por cada item.\nreturn entregas.map(e => {\n  const pagado = e.estado === 'pagado';\n  // \"pendiente\" viene calculado por la app: aquí solo se da formato.\n  const falta = Number(e.pendiente).toFixed(2).replace('.', ',');\n\n  const asunto = pagado\n    ? `Mañana puedes recoger tu ${e.tarta}`\n    : `Mañana es la entrega de tu ${e.tarta}`;\n\n  const texto = pagado\n    ? `Hola ${e.cliente}:\\n\\nTu ${e.tarta} estará lista mañana, ${fechaBonita}. Ya está pagada, así que solo tienes que pasar a recogerla.\\n\\n¡Gracias!`\n    : `Hola ${e.cliente}:\\n\\nMañana, ${fechaBonita}, es la entrega de tu ${e.tarta}.\\n\\nAún te faltan ${falta} € por pagar. Puedes pagarlos al recogerla.\\n\\n¡Gracias!`;\n\n  return {\n    json: {\n      encargo_id: e.id,\n      cliente: e.cliente,\n      email: e.email,\n      tarta: e.tarta,\n      estado: e.estado,\n      pendiente: e.pendiente,\n      fecha_entrega: e.fecha_entrega,\n      sin_email: !e.email,\n      asunto_cliente: asunto,\n      texto_cliente: texto,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
